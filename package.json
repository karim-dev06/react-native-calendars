{
  "name": "@3by4/react-native-calendars",
  "version": "1.1.3",
  "main": "src/index.ts",
  "types": "src/index.d.ts",
  "description": "React Native ExpandableCalendar Component - Minimal fork focused on ExpandableCalendar",
  "scripts": {
    "build": "yarn build:tsc && yarn build:docs",
    "build:ts": "tsc",
    "build:dev": "tsc --noEmit",
    "build:docs": "node ./scripts/build-docs.js",
    "e2e": "node ./scripts/test-e2e.js --release",
    "test": "yarn lint && yarn unit",
    "test:watch": "jest --watch",
    "unit": "jest",
    "lint": "eslint src/ --ext .tsx,.ts,.js",
    "release": "node ./scripts/release.js",
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "xcode": "open ios/CalendarsExample.xcworkspace/",
    "clean": "rm yarn-lock && rm -rf ./node_modules && yarn",
    "pod-install": "pod install --project-directory=ios"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karim-dev06/react-native-calendars"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "Karimulla Mohammed (karim-dev06)",
  "license": "MIT",
  "dependencies": {
    "lodash": "^4.17.15",
    "prop-types": "^15.5.10",
    "react-native-swipe-gestures": "^1.0.5",
    "xdate": "^0.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/eslint-parser": "^7.13.4",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native/babel-preset": "0.73.21",
    "@react-native/eslint-config": "0.73.2",
    "@react-native/metro-config": "0.73.5",
    "@react-native/typescript-config": "0.73.1",
    "@types/jest": "^29.2.1",
    "@types/lodash": "^4.14.170",
    "@types/react": "^18.2.6",
    "@types/react-native": "^0.64.19",
    "@types/react-test-renderer": "^18.2.0",
    "@types/xdate": "^0.8.32",
    "@typescript-eslint/eslint-plugin": "^5.27.1",
    "@typescript-eslint/parser": "^5.27.1",
    "babel-jest": "^29.6.3",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "8.19.0",
    "eslint-config-prettier": "^6.11.0",
    "eslint-plugin-jest": "^26.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.24.0",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^29.6.3",
    "jest-date-mock": "^1.0.8",
    "metro-react-native-babel-preset": "0.73.7",
    "prettier": "2.8.8",
    "react": "18.2.0",
    "react-native": "0.73.11",
    "react-test-renderer": "18.2.0",
    "semver": "5.x.x",
    "shell-utils": "1.x.x",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
